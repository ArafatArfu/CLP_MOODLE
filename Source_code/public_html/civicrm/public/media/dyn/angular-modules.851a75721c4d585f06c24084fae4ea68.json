{"api4":{"domain":"civicrm","js":["\/core\/ang\/api4.js","\/core\/ang\/api4\/crmApi4.js"],"css":[],"partials":[],"strings":[]},"crmResetPassword":{"domain":"standaloneusers","js":["\/core\/ext\/standaloneusers\/ang\/crmResetPassword.js"],"css":[],"partials":{"~\/crmResetPassword\/crmResetPassword.html":"<div>\n  <!-- without a token, we offer for them to generate one. -->\n  <form name=\"requestLink\" crm-ui-id-scope\n    ng-if=\"!$ctrl.formSubmitted && !$ctrl.token\">\n\n    <h1>{{:: ts('Reset Password')}}<\/h1>\n\n    <p>{{:: ts('You will receive an email with instructions on how to reset your password.')}}<\/p>\n\n    <div class=\"input-wrapper\">\n      <label crm-ui-for=\"identifier\">{{:: ts('Enter the username or email on your account')}}<\/label>\n      <input\n          crm-ui-id=\"identifier\"\n          name=\"identifier\"\n          ng-model=\"$ctrl.identifier\"\n          class=\"crm-form-text form-control\"\n          type=text\n          \/>\n    <\/div>\n\n    <button class=crm-button ng-click=\"$ctrl.requestPasswordResetEmail()\" >{{:: ts('Request Password Reset')}}<\/button>\n  <\/form>\n\n  <div ng-if=\"$ctrl.resetSuccessfullySubmitted\" class=\"help\" >\n    <p>{{:: ts('Thanks. If your username\/email matched an active account, we will email you with a special link to provide a new password.')}}<\/p>\n    <p>{{:: ts('The link must be used within an hour, and can only be used once.')}}<\/p>\n  <\/div>\n\n  <div ng-if=\"$ctrl.busy\" >{{$ctrl.busy}}<\/div>\n\n  <!-- without a token, we offer for them to generate one. -->\n  <form ng-if=\"$ctrl.token && $ctrl.token !== 'invalid' && !$ctrl.formSubmitted\" name=\"resetPassword\" crm-ui-id-scope >\n    <h1>{{:: ts('Reset Password')}}<\/h1>\n\n    <div class=\"input-wrapper\">\n      <label crm-ui-for=\"newPassword\">{{:: ts('Enter a new password')}}<\/label>\n      <input\n          crm-ui-id=\"newPassword\"\n          name=\"newPassword\"\n          ng-model=\"$ctrl.newPassword\"\n          class=\"crm-form-text form-control\"\n          type=password\n          \/>\n    <\/div>\n    <div class=\"input-wrapper\">\n      <label crm-ui-for=\"newPasswordAgain\">{{:: ts('Re-enter new password')}}<\/label>\n      <input\n          crm-ui-id=\"newPasswordAgain\"\n          name=\"newPasswordAgain\"\n          ng-model=\"$ctrl.newPasswordAgain\"\n          class=\"crm-form-text form-control\"\n          type=password\n          \/>\n      <span class=\"crm-error\" ng-show=\"$ctrl.newPasswordAgain && $ctrl.newPassword && $ctrl.newPassword !== $ctrl.newPasswordAgain\">\n          {{:: ts('Passwords do not match')}}\n      <\/span>\n    <\/div>\n\n    <button class=crm-button ng-click=\"$event.preventDefault();$ctrl.attemptChange()\" ng-disabled=\"$ctrl.formSubmitted\">{{:: ts('Change Password')}}<\/button>\n  <\/form>\n\n  <div ng-if=\"$ctrl.token === 'invalid'\" >\n    <p>{{:: ts(\"This password reset link has expired or is otherwise invalid.\")}}<\/p>\n    <p><a href ng-click=\"$ctrl.completeReset()\">{{:: ts('Send new password reset link')}}<\/a><\/p>\n  <\/div>\n\n<\/div>\n\n"},"strings":[]},"crmResource":{"domain":"civicrm","js":["\/core\/js\/angular-crmResource\/all.js"],"css":[],"partials":[],"strings":[]},"crmUi":{"domain":"civicrm","js":["\/core\/ang\/crmUi.js"],"css":["\/core\/ang\/crmUI.css"],"partials":{"~\/crmUi\/field-cb.html":"<label crm-depth=\"1\">\n  <span ng-transclude><\/span>\n  <span ng-class=\"cssClasses\">\n    {{crmUiField.title}}\n  <\/span>\n<\/label>\n<a crm-ui-help=\"help\" ng-if=\"crmUiField.help\"><\/a>\n<div class=\"clear\"><\/div>\n","~\/crmUi\/field.html":"<div class=\"label\">\n  <label crm-ui-for=\"{{crmUiField.name}}\" crm-depth=\"1\" crm-ui-force-required=\"{{crmUiField.required}}\">{{crmUiField.title}}<\/label>\n  <a crm-ui-help=\"help\" ng-if=\"help\"><\/a>\n<\/div>\n<div class=\"content\" ng-transclude><\/div>\n<div class=\"clear\"><\/div>\n","~\/crmUi\/tabset.html":"<div class=\"crm-tabset\">\n  <ul role=\"tablist\" class=\"crm-tab-list\">\n    <li ng-repeat=\"tab in tabs\" role=\"tab\" class=\"ui-corner-all crm-tab-button crm-count-{{tab.count}}\">\n      <a ng-href=\"#{{tab.id}}\">\n        <i ng-if=\"tab.crmIcon\" class=\"crm-i {{tab.crmIcon}}\" aria-hidden=\"true\"><\/i>\n        {{tab.$parent.$eval(tab.crmTitle)}}\n        <em ng-if=\"tab.count\">{{tab.count}}<\/em>\n      <\/a>\n    <\/li>\n  <\/ul>\n  <div ng-transclude role=\"tabpanel\" class=\"crm-tab-panel\"><\/div>\n<\/div>\n","~\/crmUi\/wizard.html":"<div class=\"crm-wizard\">\n  <ul class=\"crm-wizard-nav wizard-bar\">\n    <li ng-repeat=\"step in steps\" ng-class=\"{'current-step':step.selected}\" class=\"{{crmUiWizardNavClass}}\">\n      <i class=\"{{crmUiWizardCtrl.iconFor($index)}}\"><\/i>\n      <a href=\"\" ng-click=\"crmUiWizardCtrl.select(step)\" ng-show=\"crmUiWizardCtrl.isSelectable(step)\">{{1 + $index}}. {{step.$parent.$eval(step.crmTitle)}}<\/a>\n      <span ng-show=\"!crmUiWizardCtrl.isSelectable(step)\">{{1 + $index}}. {{step.$parent.$eval(step.crmTitle)}}<\/span>\n      <!-- Don't know a good way to localize text like \"1. Title\" -->\n    <\/li>\n  <\/ul>\n  <div class=\"crm-wizard-body\" ng-transclude><\/div>\n  <div class=\"crm-wizard-buttons\">\n    <button crm-icon=\"fa-chevron-left\" ng-click=\"crmUiWizardCtrl.previous()\" ng-show=\"!crmUiWizardCtrl.$first()\" class=\"crmUi-btn-primary\">{{:: ts('Previous') }}<\/button>\n    <button crm-icon=\"fa-chevron-right\" title=\"{{!crmUiWizardCtrl.$validStep() ? ts('Complete all required fields first') : ts('Next step')}}\" ng-click=\"crmUiWizardCtrl.next()\" ng-show=\"!crmUiWizardCtrl.$last()\" ng-disabled=\"!crmUiWizardCtrl.$validStep()\" class=\"crmUi-btn-primary\">{{:: ts('Next') }}<\/button>\n  <\/div>\n<\/div>\n"},"strings":[]},"crmUtil":{"domain":"civicrm","js":["\/core\/ang\/crmUtil.js"],"css":[],"partials":[],"strings":[]}}