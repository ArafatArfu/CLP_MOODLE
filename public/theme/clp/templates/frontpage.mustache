{{!
    @template theme_clp/frontpage

    CLP front page template.

    Context variables required for this template:
    * sitename - The name of the site
    * output - The core renderer for the page
    * bodyattributes - attributes for the body tag as a string of html attributes
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>

<div id="page-wrapper" class="d-print-block">

    {{{ output.standard_top_of_body_html }}}

    {{> theme_clp/navbar }}

    <div id="page" class="container-fluid d-print-block">
        {{{ output.full_header }}}

        <!-- CLP Homepage Sections -->
        <section class="content">
            <!-- Carousel -->
            <div id="clp-slider" class="carousel slide" data-ride="carousel" data-interval="5000">
                <div class="carousel-inner">
                    <div class="item active">
                        <img class="img-responsive" src="{{ config.wwwroot }}/theme/clp/assets/images/slider/homeSlider/clc_slider1.jpg" alt="Computer Literacy Center"/>
                        <div class="carousel-caption">
                            <h1>Computer Literacy Center (CLC) is a computer lab run by trained teachers to make underprivileged students digitally literate.</h1>
                        </div>
                    </div>
                    <div class="item">
                        <img class="img-responsive" src="{{ config.wwwroot }}/theme/clp/assets/images/slider/homeSlider/csaw_slider.jpg" alt="Connect Students Around the World"/>
                        <div class="carousel-caption">
                            <h1>Connect Students Around The World (CSAW) brings together students from different countries to build friendship and English communication skills.</h1>
                        </div>
                    </div>
                    <div class="item">
                        <img class="img-responsive" src="{{ config.wwwroot }}/theme/clp/assets/images/slider/homeSlider/scr_slider.jpg" alt="Smart Classroom"/>
                        <div class="carousel-caption">
                            <h1>Smart Classrooms (SCRs) bring technology-aided, enjoyable and sustainable learning to rural secondary school students.</h1>
                        </div>
                    </div>
                    <div class="item">
                        <img class="img-responsive" src="{{ config.wwwroot }}/theme/clp/assets/images/slider/homeSlider/rvt_slider.jpg" alt="Remote Voluntary Teaching"/>
                        <div class="carousel-caption">
                            <h1>Remote Voluntary Teaching (RVT) connects rural students with live online classes taught by subject experts from around the globe.</h1>
                        </div>
                    </div>
                </div>
                <a class="left carousel-control" href="#clp-slider" data-slide="prev" role="button">
                    <span class="fa fa-angle-left" aria-hidden="true"></span>
                    <span class="sr-only">Previous</span>
                </a>
                <a class="right carousel-control" href="#clp-slider" data-slide="next" role="button">
                    <span class="fa fa-angle-right" aria-hidden="true"></span>
                    <span class="sr-only">Next</span>
                </a>
            </div>

            <!-- Call Out -->
            <section class="call-out">
                <div class="container">
                    <div class="row">
                        <div class="col-sm-12 col-xs-12">
                            <div class="statement-inner">
                                <h4>Empowering underprivileged youths through computer literacy training and technology-aided education. </h4>
                                <span class="statement-innert"><b>CLP MISSION STATEMENT</b></span>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Programs Section -->
            <section class="here-bangladesh-wrap">
                <div class="container">
                    <div class="col-md-8 col-sm-12 col-xs-12">
                        <div class="blog-info">
                            <p>CLP promotes the knowledge and usage of computer and information technology among the underprivileged youths in Bangladesh. We do so in following ways:</p>
                        </div>
                        <div class="blog-list row">
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="blog-single thumbnail home-thumb">
                                    <div class="blog-thumb">
                                        <a href="{{ config.wwwroot }}/my/"><img src="{{ config.wwwroot }}/theme/clp/assets/images/homepage/program-img/clc-prg_cover_500_300.webp" class="img-fluid" alt="blog thumbnail"/></a>
                                    </div>
                                    <div class="blog-info">
                                        <h4 class="title"><a href="{{ config.wwwroot }}/my/">COMPUTER LITERACY CENTER (CLC)</a></h4>
                                        <p class="blog-text">We equip Computer Literacy Center (CLCs) with computers, internet connectivity, curriculum and trained teachers for students to become computer literate.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="blog-single thumbnail home-thumb">
                                    <div class="blog-thumb">
                                        <a href="{{ config.wwwroot }}/my/"><img src="{{ config.wwwroot }}/theme/clp/assets/images/homepage/program-img/scr-prg-cover_500_300.webp" class="img-fluid" alt="blog thumbnail"></a>
                                    </div>
                                    <div class="blog-info">
                                        <h4 class="title"><a href="{{ config.wwwroot }}/my/">SMART CLASSROOM<br>(SCR)</a></h4>
                                        <p class="blog-text">We equip Smart Classrooms (SCRs) with large screen monitor, computer, contents and subject based trained teachers for student's enjoyable and sustainable learning.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="blog-single thumbnail home-thumb">
                                    <div class="blog-thumb">
                                        <a href="{{ config.wwwroot }}/my/"><img src="{{ config.wwwroot }}/theme/clp/assets/images/homepage/program-img/rvt-prg_cover_500_300.webp" alt="blog thumbnail"></a>
                                    </div>
                                    <div class="blog-info">
                                        <h4 class="title"><a href="{{ config.wwwroot }}/my/">REMOTE VOLUNTARY TEACHING (RVT)</a></h4>
                                        <p class="blog-text">We create opportunities for rural students to participate different live online classes of subject-based experts who connect from locations across the globe.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="blog-list row">
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="blog-single thumbnail home-thumb">
                                    <div class="blog-thumb">
                                        <a href="{{ config.wwwroot }}/my/"><img src="{{ config.wwwroot }}/theme/clp/assets/images/homepage/program-img/csawweb_500_300-min.webp" alt="blog thumbnail"></a>
                                    </div>
                                    <div class="blog-info">
                                        <h4 class="title"><a href="{{ config.wwwroot }}/my/">CONNECT STUDENTS AROUND THE WORLD (CSAW)</a></h4>
                                        <p class="blog-text">We bring students together from two different countries, aims at fostering cultural communication, friendship and English communication skills development.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="blog-single thumbnail home-thumb">
                                    <div class="blog-thumb">
                                        <a href="{{ config.wwwroot }}/my/"><img src="{{ config.wwwroot }}/theme/clp/assets/images/homepage/program-img/ee-prg_cover_500_300.webp" alt="blog thumbnail"></a>
                                    </div>
                                    <div class="blog-info">
                                        <h4 class="title"><a href="{{ config.wwwroot }}/my/">EDUCATION THROUGH ENTERTAINMENT (EE)</a></h4>
                                        <p class="blog-text">We provide students an entertaining platform for acquiring knowledge on tolerance, global awareness, entrepreneurship and sharpen student's communication skills.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12">
                                <div class="blog-single thumbnail home-thumb">
                                    <div class="blog-thumb">
                                        <a href="{{ config.wwwroot }}/my/"><img src="{{ config.wwwroot }}/theme/clp/assets/images/homepage/program-img/development-prg_cover_500_300.webp" alt="blog thumbnail"></a>
                                    </div>
                                    <div class="blog-info">
                                        <h4 class="title"><a href="{{ config.wwwroot }}/my/">DEVELOP TRAINING MATERIALS AND CONTENTS</a></h4>
                                        <p class="blog-text">We engage with experts to design fitting curriculum for computer literacy training in CLCs and the subjects taught in SCRs.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <p class="about-us-btn"><a class="read-more" href="{{ config.wwwroot }}/about.php">ABOUT US</a></p>
                    </div>

                    <div class="col-md-4 col-sm-12 col-xs-12">
                        <div class="panel panel-default latest-program">
                            <div class="panel-body">
                                <h4 style="color:#006b4f;"><strong>Newest Event</strong></h4>
                                <div class="latestNews green">
                                    <ul></ul>
                                </div>
                            </div>
                        </div>
                        <div class="sidebar-area">
                            <div class="widget widget-letest-news">
                                <div class="widget-title">
                                    <h2>Latest News:</h2>
                                </div>
                                <div class="news-list">
                                    <div class="blog-info">
                                        <a class="read-more" href="{{ config.wwwroot }}/my/">View All</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Introduction / Success Story -->
            <section class="introduction-wrap fact-counter-2 sec-padd" style="background-image: url({{ config.wwwroot }}/theme/clp/assets/images/bg.webp);">
                <div class="welcome-area ptb--100">
                    <div class="container">
                        <div class="welcome-content">
                            <div class="story-video">
                                <a class="gallery_video" href="https://youtu.be/LyfZvb2KGU0">
                                    <img src="{{ config.wwwroot }}/theme/clp/assets/images/play.svg" alt="">
                                </a>
                            </div>
                            <div class="welcome-inner">
                                <div class="blog-info">
                                    <h2>Success Story Spotlight: Merina Rashid</h2>
                                    <p class="we-belong work_para" style="font-size: 14px;">Merina Rashid was one of our society's underprivileged girls. Since her father died when she was eight years old, Dustho Meyeder Nirapad Ashram o Punorbashan Kendro (DMNAPK) located in Gazipur stood by her as her family's financial condition deteriorated. She found asylum at DMNAPK and attended classes there from elementary to higher secondary school. She learnt computer for free in her struggling life after setting up a Computer Literacy Center (CLC) from Computer Literacy Program (CLP) at DMNAPK in 2017. Following this, she is currently working in an organization called ATI Limited by applying this computer education in her life.</p>
                                    <a class="read-more" href="{{ config.wwwroot }}/my/">More Stories</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Students Count -->
            <section class="students-count-wrap">
                <div class="container">
                    <div class="row">
                        <div class="col-sm-12 col-xs-12">
                            <h2></h2>
                            <p>Students have received basic computer literacy training from the CLCs established by the Computer Literacy Program and its implementation partner Dnet in Bangladesh with support from sponsors and local school administrations.</p>
                            <h2 class="extr-mrg">%</h2>
                            <p>of the graduates are female.</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- CLC Stands -->
            <section class="clc-stands-wrap">
                <div class="container">
                    <div class="row">
                        <div class="col-sm-6 col-xs-12">
                            <p><img alt="images" src="{{ config.wwwroot }}/theme/clp/assets/images/homepage/side1.webp" class="img-responsive"/></p>
                        </div>
                        <div class="col-sm-6 col-xs-12">
                            <p class="clc-stand-text">A Computer Literacy Center (CLC) is a computer lab run by CLP trained teachers to provide students with hands-on training in computer usage using a structured curriculum. Every computer lab is equipped with a minimum of four computers, one printer, requisite accessories, furniture and Internet connection (where available).</p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-7 col-xs-12 clc-stands">
                            <div class="row">
                                <div class="col-sm-6 col-xs-12">
                                    <div class="stand-inner-col">
                                        <h1>$</h1>
                                        <h5>is the cost to sponsor a Computer Literacy Center.</h5>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-xs-12">
                                    <div class="stand-inner-col brd-none">
                                        <h1></h1>
                                        <h5>Computer Literacy Centers have been established in Bangladesh.</h5>
                                    </div>
                                </div>
                            </div>
                            <p class="learn-more-btn-btn">
                                <a href="{{ config.wwwroot }}/my/" class="read-more">Learn More</a>
                                <span style="padding-left: 12px;"> <a href="{{ config.wwwroot }}/my/" class="read-more">Sponsor A CLC</a></span>
                            </p>
                        </div>
                        <div class="col-sm-5 col-xs-12">
                            <p><img alt="images" src="{{ config.wwwroot }}/theme/clp/assets/images/homepage/video-thumb.webp" class="img-responsive mrg-top"/></p>
                        </div>
                    </div>
                    <div class="row SCR-stands">
                        <div class="col-sm-5 col-xs-12">
                            <p><img alt="images" src="{{ config.wwwroot }}/theme/clp/assets/images/homepage/Pic4web.webp" class="img-responsive"/></p>
                        </div>
                        <div class="col-sm-7 col-xs-12">
                            <p class="clc-stand-text">Smart Class Rooms (SCRs) brings the educational opportunities provided by advances in personal computer, Internet, educational CDs, and ICT-based interactive learning materials to secondary school students in rural Bangladesh. Every SCR is equipped with a laptop, a large screen TV monitor, educational CDs and contents from web. SCRs are readily adaptable for remote instruction</p>
                            <div class="row">
                                <div class="col-sm-6 col-xs-12">
                                    <div class="stand-inner-col">
                                        <h1>$</h1>
                                        <h5>is the cost for establishing a Smart Class Room.</h5>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-xs-12">
                                    <div class="stand-inner-col brd-none">
                                        <h1></h1>
                                        <h5>Smart Class Rooms have been established in Bangladesh.</h5>
                                    </div>
                                </div>
                            </div>
                            <p class="learn-more-btn-btn"><a href="{{ config.wwwroot }}/my/" class="read-more">Learn More</a>
                                <span style="padding-left: 12px;"> <a href="{{ config.wwwroot }}/my/" class="read-more">Sponsor A SCR</a></span>
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Partners -->
            <section class="our-partners-wrap sec-padd">
                <div class="container">
                    <div class="section-title center">
                        <h2>How You Can Help</h2>
                    </div>
                    <div class="card-columns">
                        <div class="card partner-items">
                            <div class="img-col">
                                <img src="{{ config.wwwroot }}/theme/clp/assets/images/clcstudent.webp" alt="clcstudent" class="img-responsive">
                            </div>
                            <div class="text-col">
                                <div class="inner">
                                    <h4><a href="{{ config.wwwroot }}/my/">SPONSOR A CLC</a> AND/OR <a href="{{ config.wwwroot }}/my/"> A SCR</a></h4>
                                    <p style="font-family: 'Noto Sans Display', sans-serif;">The cost to sponsor a Computer Literacy Center or Smart Class Room ranges from 0,800 - 0,000 depending on the range of equipment needed for setup. You may choose the school where you want to establish a Computer Literacy Center and/or a Smart Class Room.</p>
                                </div>
                            </div>
                        </div>
                        <div class="card partner-items mrg">
                            <div class="img-col">
                                <img src="{{ config.wwwroot }}/theme/clp/assets/images/homepage/img3web.webp" alt="img" class="img-responsive">
                            </div>
                            <div class="text-col">
                                <div class="inner">
                                    <h4><a href="{{ config.wwwroot }}/my/">BE A CLP VOLUNTEER</a></h4>
                                    <p style="font-size: 14.5px; font-family: 'Noto Sans Display', sans-serif;">If you are motivated by the CLP mission, we invite you to donate your time and enlist as a CLP volunteer. Email us at vabnj@hotmail.com or by filling out the form on our volunteer page.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <p class="besides-text">Besides sponsorship and volunteer opportunities, we welcome general donations with gratitude. General donation funds are used for maintaining the centers, providing technical field support, replacing hardware and subsidizing part of the center establishment cost. Your contribution further enhances if your employer has corporate matching option. Please check with your employer.</p>
                </div>
            </section>

            <!-- Testimonials -->
            <section class="testimonial-section-one">
                <div class="container-fluid">
                    <div class="section-title center">
                        <h2>Testimonals from <span class="thm-color">Our Sponsors</span></h2>
                    </div>
                    <div class="inner-container">
                        <div class="carousel-outer">
                            <ul class="testimonial-slider-content">
                                <li class="slide-item">
                                    <div class="statement-innertestimonial">
                                        <h4>"I am very pleased with CLP. I sponsored a Computer Literacy Center in Refaitpur High School in my village Refaitpur in Kushtia, Bangladesh. CLP helped set up the center in 2006, trained two teachers, and provided a structured curriculum for students. The center has been functioning well till June 2021 and producing computer literacy graduates. CLP helped maintain equipment, trouble shoot, replace obsolete hardware and keep the center running. Center activities are temporarily on hold due to the pandemic; expected to resume when schools open." </h4>
                                        <span class="statement-innert"><b>Dr. Abul K. Azad (Albany, NY)</b></span>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="container">
                        <div class="row justify-content-center">
                            <div class="col-sm-3"></div>
                            <div class="col-sm-3 col-xs-6">
                                <div class="stand-inner-col">
                                    <h1></h1>
                                    <h5>Total Visitors Today</h5>
                                </div>
                            </div>
                            <div class="col-sm-3 col-xs-6">
                                <div class="stand-inner-col brd-none">
                                    <h1 id="monthlyVisitorCount"></h1>
                                    <h5>Total Visitors This Month</h5>
                                </div>
                            </div>
                            <div class="col-sm-3"></div>
                        </div>
                    </div>
                    <p class="btn-area donate-now">
                        <a href="{{ config.wwwroot }}/my/" class="thm-btn">DONATE NOW</a>
                    </p>
                </div>
            </section>
        </section>

        <!-- Scroll Top -->
        <button class="scroll-top tran3s"><span class="fa fa-angle-up"></span></button>

        <!-- Preloader -->
        <div class="preloader"></div>
        <script>
        (function() {
            var timeout = setTimeout(function() {
                var preloader = document.querySelector('.preloader');
                if (preloader) {
                    preloader.style.transition = 'opacity 0.5s ease';
                    preloader.style.opacity = '0';
                    setTimeout(function() {
                        preloader.style.display = 'none';
                    }, 500);
                }
            }, 3000);
            window.addEventListener('load', function() {
                clearTimeout(timeout);
                var preloader = document.querySelector('.preloader');
                if (preloader) {
                    preloader.style.transition = 'opacity 0.5s ease';
                    preloader.style.opacity = '0';
                    setTimeout(function() {
                        preloader.style.display = 'none';
                    }, 500);
                }
            });
        })();
        </script>
        <!-- End of preloader -->

        <!-- Search Popup -->
        <div class="donate-popup" id="search-popup">
            <div class="close-donate theme-btn">
                <span class="fa fa-close"></span>
            </div>
            <div class="popup-inner">
                <div class="container">
                    <div class="row">
                        <div class="col-sm-12 donate-form-area">
                            <form class="subscribe-form">
                                <div class="form-group">
                                    <input type="text" class="form-control" placeholder="Search"
                                           onfocus="this.placeholder=''"
                                           onblur="this.placeholder='Search'">
                                    <a href="#" class="search-icon"><i aria-hidden="true" class="fa fa-search"></i></a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
    {{{ output.standard_after_main_region_html }}}
    {{> theme_clp/footer }}
</div>
