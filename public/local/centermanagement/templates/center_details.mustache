{{< local_centermanagement/header }}
{{< boost/notification_wrapper }}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="card-title">{{#str}}viewcenter, local_centermanagement{{/str}}</h3>
                    <div class="card-tools">
                        <a href="{{backurl}}" class="btn btn-secondary">
                            <i class="fa fa-arrow-left"></i> {{#str}}backtoallcenters, local_centermanagement{{/str}}
                        </a>
                        {{#canedit}}
                        <a href="{{editurl}}" class="btn btn-primary">
                            <i class="fa fa-edit"></i> {{#str}}edit, local_centermanagement{{/str}}
                        </a>
                        {{/canedit}}
                    </div>
                </div>
                <div class="card-body">
                    {{#bannerimages}}
                    <div class="school-banner mb-3">
                        <div class="clp-slider" data-simpleslider="true">
                            <div class="clp-slides">
                                {{#bannerimages}}
                                <div class="clp-slide{{#first}} is-active{{/first}}">
                                    <img src="{{{url}}}" alt="Banner" loading="{{#first}}eager{{/first}}{{^first}}lazy{{/first}}">
                                </div>
                                {{/bannerimages}}
                            </div>
                            <button class="clp-prev" aria-label="Previous">&#10094;</button>
                            <button class="clp-next" aria-label="Next">&#10095;</button>
                            <div class="clp-dots">
                                {{#bannerimages}}
                                <button class="clp-dot{{#first}} is-active{{/first}}" aria-label="Slide" data-index="{{@index}}"></button>
                                {{/bannerimages}}
                            </div>
                        </div>
                    </div>
                    {{/bannerimages}}

                    <table class="table table-bordered">
                        <tr><th>{{#str}}centercode, local_centermanagement{{/str}}</th><td>{{center_code}}</td></tr>
                        <tr><th>{{#str}}centername, local_centermanagement{{/str}}</th><td>{{center_name}}</td></tr>
                        <tr><th>{{#str}}schoolname, local_centermanagement{{/str}}</th><td>{{school_name}}</td></tr>
                        <tr><th>{{#str}}centertype, local_centermanagement{{/str}}</th><td>{{center_type}}</td></tr>
                        <tr><th>{{#str}}division, local_centermanagement{{/str}}</th><td>{{division}}</td></tr>
                        <tr><th>{{#str}}district, local_centermanagement{{/str}}</th><td>{{district}}</td></tr>
                        <tr><th>{{#str}}upazila, local_centermanagement{{/str}}</th><td>{{upazila}}</td></tr>
                        <tr><th>{{#str}}address, local_centermanagement{{/str}}</th><td>{{address}}</td></tr>
                        <tr><th>{{#str}}contactperson, local_centermanagement{{/str}}</th><td>{{contact_person}}</td></tr>
                        <tr><th>{{#str}}contactnumber, local_centermanagement{{/str}}</th><td>{{contact_number}}</td></tr>
                        <tr><th>{{#str}}email, local_centermanagement{{/str}}</th><td>{{email}}</td></tr>
                        <tr><th>{{#str}}establishmentdate, local_centermanagement{{/str}}</th><td>{{establishment_date}}</td></tr>
                        <tr><th>{{#str}}startdate, local_centermanagement{{/str}}</th><td>{{start_date}}</td></tr>
                        <tr><th>{{#str}}support, local_centermanagement{{/str}}</th><td>{{support}}</td></tr>
                        <tr><th>{{#str}}sponsorname, local_centermanagement{{/str}}</th><td>{{sponsor_name}}</td></tr>
                        <tr><th>{{#str}}devicescount, local_centermanagement{{/str}}</th><td>{{devices_count}}</td></tr>
                        <tr><th>{{#str}}studentscount, local_centermanagement{{/str}}</th><td>{{students_count}}</td></tr>
                        <tr><th>{{#str}}status, local_centermanagement{{/str}}</th><td>{{status}}</td></tr>
                        <tr><th>{{#str}}description, local_centermanagement{{/str}}</th><td>{{{description}}}</td></tr>
                        <tr><th>{{#str}}image, local_centermanagement{{/str}}</th><td>{{#image}}<img src="{{{image}}}" style="max-width:200px;">{{/image}}{{^image}}No image{{/image}}</td></tr>
                        <tr><th>{{#str}}centermodified, local_centermanagement{{/str}}</th><td>{{timemodified}}</td></tr>
                    </table>

                    {{#plaqueimages}}
                    <div class="mt-3">
                        <h4>{{#str}}plaque, local_centermanagement{{/str}}</h4>
                        <div class="clp-gallery" id="plaque-gallery">
                            {{#plaqueimages}}
                            <a href="{{{.}}}" class="clp-gallery-item" data-lightbox="plaque-gallery" data-title="Plaque">
                                <img src="{{{.}}}" alt="Plaque" loading="lazy">
                            </a>
                            {{/plaqueimages}}
                        </div>
                    </div>
                    {{/plaqueimages}}

                    {{#schoolphotos}}
                    <div class="mt-3">
                        <h4>{{#str}}schoolphotos, local_centermanagement{{/str}}</h4>
                        <div class="clp-gallery" id="school-photo-gallery">
                            {{#schoolphotos}}
                            <a href="{{{.}}}" class="clp-gallery-item" data-lightbox="school-photo-gallery" data-title="School Photo">
                                <img src="{{{.}}}" alt="School Photo" loading="lazy">
                            </a>
                            {{/schoolphotos}}
                        </div>
                    </div>
                    {{/schoolphotos}}

                    {{#sponsors}}
                    <div class="mt-3">
                        <h4>{{#str}}sponsors, local_centermanagement{{/str}}</h4>
                        <div class="row">
                            {{#sponsors}}
                            <div class="col-md-6 col-lg-4 mb-3">
                                <div class="card sponsor-card">
                                    <div class="card-body">
                                        <h5 class="card-title">{{name}}</h5>
                                        {{#country}}<p><strong>{{#str}}sponsorcountry, local_centermanagement{{/str}}:</strong> {{country}}</p>{{/country}}
                                        {{#address}}<p><strong>{{#str}}sponsoraddress, local_centermanagement{{/str}}:</strong> {{address}}</p>{{/address}}
                                        {{#email}}<p><strong>{{#str}}email, local_centermanagement{{/str}}:</strong> <a href="mailto:{{email}}">{{email}}</a></p>{{/email}}
                                        {{#phone}}<p><strong>{{#str}}phone, local_centermanagement{{/str}}:</strong> <a href="tel:{{phone}}">{{phone}}</a></p>{{/phone}}
                                    </div>
                                </div>
                            </div>
                            {{/sponsors}}
                        </div>
                    </div>
                    {{/sponsors}}
                </div>
            </div>
        </div>
    </div>
</div>

{{< boost/footer }}

<script>
(function() {
    document.querySelectorAll('.clp-slider').forEach(function(slider) {
        var slides = slider.querySelectorAll('.clp-slide');
        var dots = slider.querySelectorAll('.clp-dot');
        var prev = slider.querySelector('.clp-prev');
        var next = slider.querySelector('.clp-next');
        var current = 0;
        var timer = null;

        function show(index) {
            if (index >= slides.length) index = 0;
            if (index < 0) index = slides.length - 1;
            current = index;
            slides.forEach(function(s, i) { s.classList.toggle('is-active', i === current); });
            dots.forEach(function(d, i) { d.classList.toggle('is-active', i === current); });
        }

        function nextSlide() { show(current + 1); }
        function prevSlide() { show(current - 1); }

        function startAuto() { timer = setInterval(nextSlide, 4000); }
        function stopAuto() { clearInterval(timer); }

        if (next) next.addEventListener('click', function() { stopAuto(); nextSlide(); startAuto(); });
        if (prev) prev.addEventListener('click', function() { stopAuto(); prevSlide(); startAuto(); });
        dots.forEach(function(d) {
            d.addEventListener('click', function() { stopAuto(); show(parseInt(d.getAttribute('data-index'), 10)); startAuto(); });
        });
        slider.addEventListener('mouseenter', stopAuto);
        slider.addEventListener('mouseleave', startAuto);

        var touchStartX = 0;
        slider.addEventListener('touchstart', function(e) { touchStartX = e.touches[0].clientX; }, {passive: true});
        slider.addEventListener('touchend', function(e) {
            var diff = e.changedTouches[0].clientX - touchStartX;
            if (Math.abs(diff) > 50) {
                stopAuto();
                if (diff > 0) prevSlide(); else nextSlide();
                startAuto();
            }
        }, {passive: true});

        document.addEventListener('keydown', function(e) {
            if (e.key === 'ArrowLeft') { stopAuto(); prevSlide(); startAuto(); }
            if (e.key === 'ArrowRight') { stopAuto(); nextSlide(); startAuto(); }
        });

        if (slides.length > 1) startAuto();
    });
})();
</script>
