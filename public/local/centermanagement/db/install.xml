<?php
defined('MOODLE_INTERNAL') || die();

$plugin->component = 'local_centermanagement';

function xmldb_local_centermanagement_install() {
    global $DB;
    $dbman = $DB->get_manager();

    $table = new xmldb_table('local_centermanagement_centers');
    $table->add_field('id', XMLDB_TYPE_INTEGER, '10', XMLDB_UNSIGNED, XMLDB_NOTNULL, XMLDB_SEQUENCE, null);
    $table->add_field('center_code', XMLDB_TYPE_CHAR, '255', null, XMLDB_NOTNULL, null, '');
    $table->add_field('center_name', XMLDB_TYPE_CHAR, '255', null, XMLDB_NOTNULL, null, '');
    $table->add_field('school_name', XMLDB_TYPE_CHAR, '255', null, null, null, '');
    $table->add_field('center_type', XMLDB_TYPE_CHAR, '50', null, XMLDB_NOTNULL, null, 'clc');
    $table->add_field('division', XMLDB_TYPE_CHAR, '255', null, null, null, null);
    $table->add_field('district', XMLDB_TYPE_CHAR, '255', null, null, null, null);
    $table->add_field('upazila', XMLDB_TYPE_CHAR, '255', null, null, null, null);
    $table->add_field('address', XMLDB_TYPE_TEXT, null, null, null, null, null);
    $table->add_field('contact_person', XMLDB_TYPE_CHAR, '255', null, null, null, null);
    $table->add_field('contact_number', XMLDB_TYPE_CHAR, '50', null, null, null, null);
    $table->add_field('email', XMLDB_TYPE_CHAR, '255', null, null, null, null);
    $table->add_field('establishment_date', XMLDB_TYPE_INTEGER, '10', XMLDB_UNSIGNED, null, null, '0');
    $table->add_field('start_date', XMLDB_TYPE_INTEGER, '10', XMLDB_UNSIGNED, null, null, '0');
    $table->add_field('support', XMLDB_TYPE_CHAR, '50', null, null, null, null);
    $table->add_field('sponsor_name', XMLDB_TYPE_TEXT, null, null, null, null, null);
    $table->add_field('devices_count', XMLDB_TYPE_INTEGER, '10', XMLDB_UNSIGNED, null, null, '0');
    $table->add_field('students_count', XMLDB_TYPE_INTEGER, '10', XMLDB_UNSIGNED, null, null, '0');
    $table->add_field('status', XMLDB_TYPE_INTEGER, '2', null, XMLDB_NOTNULL, null, '1');
    $table->add_field('image', XMLDB_TYPE_CHAR, '255', null, null, null, null);
    $table->add_field('description', XMLDB_TYPE_TEXT, null, null, null, null, null);
    $table->add_field('timecreated', XMLDB_TYPE_INTEGER, '10', XMLDB_UNSIGNED, XMLDB_NOTNULL, null, '0');
    $table->add_field('timemodified', XMLDB_TYPE_INTEGER, '10', XMLDB_UNSIGNED, XMLDB_NOTNULL, null, '0');
    $table->add_field('usermodified', XMLDB_TYPE_INTEGER, '10', XMLDB_UNSIGNED, null, null, null);

    $table->add_key('primary', XMLDB_KEY_PRIMARY, array('id'));
    $table->add_index('center_code', XMLDB_INDEX_UNIQUE, array('center_code'));
    $table->add_index('idx_centermanagement_status', XMLDB_INDEX_NOTUNIQUE, array('status'));
    $table->add_index('idx_centermanagement_division', XMLDB_INDEX_NOTUNIQUE, array('division'));
    $table->add_index('idx_centermanagement_district', XMLDB_INDEX_NOTUNIQUE, array('district'));

    if (!$dbman->table_exists($table)) {
        $dbman->create_table($table);
    }
}
